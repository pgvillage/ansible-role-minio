# {{ ansible_managed }}

# RustFS local/remote volumes.
{% if minio_server_cluster_nodes | length > 0 %}
RUSTFS_VOLUMES="{{ minio_server_cluster_nodes | join(' ') }}"
{% else %}
RUSTFS_VOLUMES="{{ minio_server_datadirs | join(' ') }}"
{% endif %}
# RustFS S3 API and console listen addresses.
RUSTFS_ADDRESS="{{ minio_server_addr }}"
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS="{{ minio_server_console_addr }}"
# Directory with the TLS certificate and key.
RUSTFS_TLS_PATH="{{ minio_rustfs_tls_path }}"

{% if minio_access_key %}
# Access Key of the server.
RUSTFS_ACCESS_KEY="{{ minio_access_key }}"
{% endif %}
{% if minio_secret_key %}
# Secret key of the server.
RUSTFS_SECRET_KEY="{{ minio_secret_key }}"
{% endif %}

{{ minio_rustfs_env_extra }}
